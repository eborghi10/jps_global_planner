# Stage world file for JPS Global Planner demo

# Set simulation parameters
resolution 0.05
interval_sim 100  # milliseconds per update step

# Configure the GUI window
window
(
  size [ 700 700 ]
  center [ 0.0 0.0 ]
  rotate [ 0.0 0.0 ]
  scale 50.0
)

# Define the map/floorplan
define floorplan model
(
  color "gray30"
  boundary 1

  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  ranger_return 1.0
)

# Define a laser scanner
define laser ranger
(
  sensor(
    range [ 0.0 3.5 ]
    fov 360.0
    samples 360
  )
  size [ 0.05 0.05 0.1 ]
  color "black"
)

# Define TurtleBot3-like differential drive robot
define turtlebot3 position
(
  size [ 0.14 0.14 0.12 ]
  origin [ 0.0 0.0 0.0 0.0 ]
  gui_nose 1
  drive "diff"
  
  # Laser scanner on top
  laser(pose [ 0.0 0.0 0.1 0.0 ])
  
  ranger_return 1.0
  obstacle_return 1
  localization "odom"
  odom_error [ 0.01 0.01 0.0 0.02 ]
)

# Load the map
floorplan
(
  name "demo_map"
  bitmap "../maps/demo_map.pgm"
  size [ 10.0 10.0 1.0 ]
  pose [ 0.0 0.0 0.0 0.0 ]
)

# Spawn the robot (in the center of an open room)
turtlebot3
(
  name "turtlebot3"
  pose [ 3.0 3.0 0.0 0.0 ]
  color "blue"
)
