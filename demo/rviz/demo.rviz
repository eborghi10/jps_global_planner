Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 200
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false
      Value: true

    - Class: rviz/Map
      Name: Global Costmap
      Enabled: true
      Topic: /move_base/global_costmap/costmap
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Value: true

    - Class: rviz/Map
      Name: Local Costmap
      Enabled: false
      Topic: /move_base/local_costmap/costmap
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Value: true

    - Class: rviz/Path
      Name: Global Plan
      Enabled: true
      Topic: /move_base/JumpPointSearchROS/plan
      Color: 0; 255; 0
      Alpha: 1.0
      Buffer Length: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Color: 255; 85; 255
      Pose Style: None
      Value: true

    - Class: rviz/Path
      Name: JPS Path
      Enabled: true
      Topic: /move_base/JumpPointSearchROS/jps_path
      Color: 255; 255; 0
      Alpha: 1.0
      Buffer Length: 1
      Line Style:
        Line Width: 0.05
        Value: Lines
      Offset:
        X: 0
        Y: 0
        Z: 0.1
      Pose Color: 255; 85; 255
      Pose Style: Arrows
      Value: true

    - Class: rviz/Path
      Name: Local Plan
      Enabled: true
      Topic: /move_base/TrajectoryPlannerROS/local_plan
      Color: 0; 0; 255
      Alpha: 1.0
      Buffer Length: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Value: true

    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true

    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1.0
      Collision Enabled: false
      Links:
        All Links Enabled: true
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true

    - Class: rviz/Marker
      Name: Goal Marker
      Enabled: true
      Marker Topic: /move_base/current_goal
      Queue Size: 100
      Value: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point

  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 15
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.5708
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14159
    Saved: ~

Window Geometry:
  Height: 900
  Width: 1200
  X: 50
  Y: 50
