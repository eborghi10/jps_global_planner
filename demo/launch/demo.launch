<?xml version="1.0"?>
<launch>
  <!-- Arguments -->
  <arg name="model" default="burger" doc="model type [burger, waffle, waffle_pi]"/>
  <arg name="map_file" default="$(find jps_global_planner)/demo/maps/demo_map.yaml"/>
  <arg name="world_file" default="$(find jps_global_planner)/demo/stage/demo.world"/>
  <arg name="open_rviz" default="true"/>

  <!-- Use simulation time from Stage -->
  <param name="use_sim_time" value="true"/>

  <!-- Stage Simulator -->
  <node pkg="stage_ros" type="stageros" name="stageros" args="$(arg world_file)" output="screen">
    <remap from="base_scan" to="scan"/>
  </node>

  <!-- Set TurtleBot3 model -->
  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro"/>

  <!-- TF -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="50.0"/>
  </node>

  <!-- Map server -->
  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)">
    <param name="frame_id" value="map"/>
  </node>

  <!-- Static transform from map to odom (offset to match robot's initial pose in Stage) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom" 
        args="3.0 3.0 0 0 0 0 map odom"/>

  <!-- Move Base with JPS Global Planner -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <!-- Global Planner: JPS -->
    <param name="base_global_planner" value="jps/JumpPointSearchROS"/>
    
    <!-- Local Planner -->
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>
    
    <!-- Load parameters -->
    <rosparam file="$(find jps_global_planner)/demo/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find jps_global_planner)/demo/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find jps_global_planner)/demo/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find jps_global_planner)/demo/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find jps_global_planner)/demo/config/move_base_params.yaml" command="load"/>
    <rosparam file="$(find jps_global_planner)/demo/config/jps_planner_params.yaml" command="load" ns="JumpPointSearchROS"/>
  </node>

  <!-- RViz -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find jps_global_planner)/demo/rviz/demo.rviz" if="$(arg open_rviz)"/>
</launch>
